# Copia este archivo a .env.local (no se commitea) y reinicia `npm run dev` después de editarlo.
# Solo valores públicos: la URL del proyecto y la anon (o publishable, sb_publishable_…) key.
# Nunca la service_role ni claves sb_secret_…
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# local (por defecto) o supabase
NEXT_PUBLIC_DATA_SOURCE=local
